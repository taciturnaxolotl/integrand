{
  "manifest_version": 3,
  "name": "integrand (dev)",
  "version": "0.1.0",
  "description": "Snip a math problem, land on a step-by-step solver with it filled in.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Snip a math problem", "default_icon": {
    "16": "images/icon-16.png", "32": "images/icon-32.png", "128": "images/icon-128.png"
  } },
  "icons": { "16": "images/icon-16.png", "32": "images/icon-32.png", "128": "images/icon-128.png" },
  "options_page": "options.html"
}
