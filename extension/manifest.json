{
  "manifest_version": 3,
  "name": "integrand",
  "version": "0.3.3",
  "description": "Snip a math problem, land on a step-by-step solver with it filled in.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://integrand.dunkirk.sh/*",
    "*://*.webassign.net/*",
    "*://*.myopenmath.com/*",
    "*://*.instructure.com/*",
    "*://*.deltamath.com/*",
    "*://*.gradescope.com/*",
    "*://*.khanacademy.org/*",
    "*://en.wikipedia.org/*",
    "*://math.stackexchange.com/*",
    "*://openstax.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Snip a math problem",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "128": "images/icon-128.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "128": "images/icon-128.png"
  },
  "options_page": "options.html",
  "optional_host_permissions": [
    "*://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Snip a maths problem"
    }
  }
}
